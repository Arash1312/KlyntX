export default class Klynt {
  constructor() {
    this.tasks = [];
    this.running = false;
  }

  add(task) {
    if (typeof task !== "function") {
      throw new TypeError("Task must be a function.");
    }

    this.tasks.push(task);
    return this;
  }

  async run() {
    if (this.running) return;

    this.running = true;

    while (this.tasks.length) {
      const task = this.tasks.shift();

      try {
        await task();
      } catch (error) {
        console.error("[Klynt]", error.message);
      }
    }

    this.running = false;
  }

  clear() {
    this.tasks.length = 0;
    return this;
  }

  get size() {
    return this.tasks.length;
  }
}

if (import.meta.url === `file://${process.argv[1]}`) {
  const queue = new Klynt();

  queue
    .add(async () => console.log("Loading assets..."))
    .add(async () => console.log("Syncing data..."))
    .add(async () => console.log("Done."));

  queue.run();
}

